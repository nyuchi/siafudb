// markdownlint-cli2 configuration for siafudb.
//
// Style rules come from the org-mirrored .markdownlint.jsonc — do
// not duplicate them here. The documentation site (including the
// research/governance .md drafts that used to live under docs/ and
// trip MD036) has moved to the separate nyuchi/docs repo, so this
// file only ignores node_modules now.
{
  "config": {
    "extends": ".markdownlint.jsonc",
  },
  "ignores": ["node_modules/**"],
}
